# Kafka Configuration
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=email-sender-service
KAFKA_GROUP_ID=email-sender-service-group

# Kafka Connection Settings (optional, defaults shown)
KAFKA_CONNECTION_TIMEOUT=10000
KAFKA_REQUEST_TIMEOUT=30000

# Kafka Consumer Settings (optional, defaults shown)
KAFKA_ALLOW_AUTO_TOPIC_CREATION=false
KAFKA_SESSION_TIMEOUT=30000
KAFKA_REBALANCE_TIMEOUT=60000
KAFKA_HEARTBEAT_INTERVAL=3000

Kafka Topics (optional, defaults shown)
KAFKA_TOPIC_EMAIL_NOTIFICATIONS=email-notifications
KAFKA_TOPIC_EMAIL_DLQ=email-dlq
KAFKA_TOPIC_COMPLAINT_STATUS_EVENTS=complaint-status-events


# Kafka Retry Policy (optional, defaults shown)
KAFKA_MAX_RETRIES=3
KAFKA_INITIAL_RETRY_TIME=100
KAFKA_MAX_RETRY_TIME=30000
KAFKA_RETRY_MULTIPLIER=2

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Server Configuration
PORT=3032

# Logging Configuration
LOG_LEVEL=info